@@ -0,0 +1,124 @@
+package dos
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+func aliasPair(t *testing.T) (*machine.Machine, *DOS, uint16, uint32) {
+	t.Helper()
+	m, d := newTest(t)
+	m.CPU.R[cpu.BX] = 2
+	if status := emsCallAX(m, d, 0x4300); status != 0 {
+		t.Fatal(status)
+	}
+	h := m.CPU.R[cpu.DX]
+	for p := 0; p < 2; p++ {
+		m.CPU.R[cpu.BX], m.CPU.R[cpu.DX] = 0, h
+		if status := emsCallAX(m, d, 0x4400+uint16(p)); status != 0 {
+			t.Fatal(status)
+		}
+	}
+	return m, d, h, uint32(machine.EMSFrameSeg) * 16
+}
+
+func TestEMSAliasCrossBoundaryAndRemap(t *testing.T) {
+	m, d, h, base := aliasPair(t)
+	defer d.Close()
+	m.Write16(base+emsPageSize-1, 0x1122)
+	if m.Read8(base+emsPageSize-1) != 0x22 || m.Read8(base+2*emsPageSize-1) != 0x22 || m.Read8(base) != 0x11 || m.Read8(base+emsPageSize) != 0x11 {
+		t.Fatal("cross-boundary word did not update both aliases")
+	}
+	m.CPU.R[cpu.BX], m.CPU.R[cpu.DX] = 1, h
+	if status := emsCallAX(m, d, 0x4400); status != 0 {
+		t.Fatal(status)
+	}
+	m.Write8(base, 0x33)
+	if m.Read8(base+emsPageSize) != 0x11 {
+		t.Fatal("different logical page changed the old alias")
+	}
+	m.CPU.R[cpu.BX], m.CPU.R[cpu.DX] = 0, h
+	if status := emsCallAX(m, d, 0x4400); status != 0 {
+		t.Fatal(status)
+	}
+	if m.Read8(base) != 0x11 {
+		t.Fatal("remap lost alias contents")
+	}
+}
+
+func TestEMSAliasSnapshotAndClose(t *testing.T) {
+	m, d, _, base := aliasPair(t)
+	defer d.Close()
+	m.Write8(base+7, 0x44)
+	var machineState, dosState bytes.Buffer
+	if err := m.SaveState(&machineState); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.SaveState(&dosState); err != nil {
+		t.Fatal(err)
+	}
+	m2, d2 := newTest(t)
+	if err := m2.LoadState(bytes.NewReader(machineState.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	if err := d2.LoadState(bytes.NewReader(dosState.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	// No EMS service call is made between restore and this guest write.
+	m2.Write8(base+7, 0x55)
+	if m2.Read8(base+emsPageSize+7) != 0x55 {
+		t.Fatal("fresh snapshot restore lost alias synchronization")
+	}
+	for i := 0; i < 3; i++ {
+		if err := d2.LoadState(bytes.NewReader(dosState.Bytes())); err != nil {
+			t.Fatal(err)
+		}
+	}
+	m2.Write8(base+7, 0x66)
+	if m2.Read8(base+emsPageSize+7) != 0x66 {
+		t.Fatal("repeated DOS restore lost alias synchronization")
+	}
+	d2.Close()
+	m2.Write8(base+7, 0x77)
+	if m2.Read8(base+emsPageSize+7) != 0x66 {
+		t.Fatal("closed DOS left an active alias callback")
+	}
+}
+
+func TestEMSAliasMultipleMapAndRestore(t *testing.T) {
+	m, d, h, base := aliasPair(t)
+	defer d.Close()
+	m.CPU.Seg[cpu.DS], m.CPU.R[cpu.SI], m.CPU.R[cpu.CX], m.CPU.R[cpu.DX] = 0, 0x900, 4, h
+	for p := 0; p < 4; p++ {
+		m.Write16(0x900+uint32(p*4), 0)
+		m.Write16(0x902+uint32(p*4), uint16(p))
+	}
+	if status := emsCallAX(m, d, 0x5000); status != 0 {
+		t.Fatal(status)
+	}
+	m.Write8(base+3*emsPageSize+9, 0x88)
+	for p := 0; p < 4; p++ {
+		if m.Read8(base+uint32(p*emsPageSize)+9) != 0x88 {
+			t.Fatal("four-way mapping lost coherence")
+		}
+	}
+	if status := emsCallAX(m, d, 0x4700); status != 0 {
+		t.Fatal(status)
+	}
+	m.CPU.R[cpu.BX], m.CPU.R[cpu.DX] = 1, h
+	if status := emsCallAX(m, d, 0x4400); status != 0 {
+		t.Fatal(status)
+	}
+	m.Write8(base+9, 0x99)
+	if status := emsCallAX(m, d, 0x4800); status != 0 {
+		t.Fatal(status)
+	}
+	for p := 0; p < 4; p++ {
+		if m.Read8(base+uint32(p*emsPageSize)+9) != 0x88 {
+			t.Fatal("page map restore lost alias data")
+		}
+	}
+}
