 func (d *DOS) emsLoad(p int, handle, page uint16) {
 	e := d.emsState()
 	h := e.handles[handle]
+	// Keep the existing delayed-writeback EMSPages interface. Before adding an
+	// alias, publish the live contents of any already mapped peer.
+	for other, mapping := range e.frame {
