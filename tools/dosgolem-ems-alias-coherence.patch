+func (d *DOS) watchEMS() {
+	if d.emsWatchID == 0 {
+		d.emsWatchID = d.M.WatchWrite(emsFrameAddr(0), emsFrameAddr(emsPhysPages)-1, func(m *machine.Machine, addr uint32, old, value uint8) {
+			e := d.ems
+			if e == nil || e.loading || e.mirroring {
+				return
+			}
+			phys := int((addr - emsFrameAddr(0)) / emsPageSize)
+			off := int((addr - emsFrameAddr(0)) % emsPageSize)
+			mapping := e.frame[phys]
+			if mapping == nil {
+				return
+			}
+			e.mirroring = true
+			defer func() { e.mirroring = false }()
+			for p, other := range e.frame {
+				if p != phys && other != nil && *other == *mapping {
+					m.Write8(emsFrameAddr(p)+uint32(off), value)
+				}
+			}
+		})
+	}
+}
+
 // emsFrameAddr 是實體頁 p 在 1 MB 空間裡的位址。
