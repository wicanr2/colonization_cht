+package machine
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestDigitalAudioTapDoesNotChangeMixOrDMA(t *testing.T) {
+	makeMachine := func(tap bool) *Machine {
+		m := sbSetup(t, 0, 0x2000, 400, 0x49)
+		m.EnableOPLSynth(true)
+		m.EnableDigitalAudioTap(tap)
+		for i := 0; i < 400; i++ {
+			m.Write8(0x2000+uint32(i), uint8(0x40+i%128))
+		}
+		dsp(m, 0xd1, 0x40, 156, 0x14, 0x8f, 0x01)
+		return m
+	}
+	a, b := makeMachine(false), makeMachine(true)
+	for _, step := range []uint64{10000, 50000, 100000, 500000} {
+		a.Steps, b.Steps = step, step
+		x, y := a.DrainAudio(), b.DrainAudio()
+		if !reflect.DeepEqual(x, y) {
+			t.Fatal("tap changed original mixed output")
+		}
+		d := b.DrainDigitalAudio()
+		if !reflect.DeepEqual(y, d) {
+			t.Fatal("silent OPL should leave exact digital samples")
+		}
+		if len(b.DrainDigitalAudio()) != 0 || len(a.DrainDigitalAudio()) != 0 {
+			t.Fatal("tap drain or disabled state")
+		}
+		if !reflect.DeepEqual(a.SBDigital(), b.SBDigital()) || !reflect.DeepEqual(a.Mem, b.Mem) {
+			t.Fatal("tap changed DMA or memory")
+		}
+	}
+	b.EnableDigitalAudioTap(false)
+	b.Steps += 10000
+	b.DrainAudio()
+	if len(b.DrainDigitalAudio()) != 0 {
+		t.Fatal("disabled tap retained data")
+	}
+	if clamp16(40000) != 32767 || clamp16(-40000) != -32768 {
+		t.Fatal("clipping")
+	}
+}
