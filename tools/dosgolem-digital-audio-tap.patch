+// EnableDigitalAudioTap optionally records the digital component of the existing
+// mixer. It never samples DMA twice or changes the original mixed output.
+// Enable the OPL synth first. Disabling discards the pending tap buffer.
+func (m *Machine) EnableDigitalAudioTap(enabled bool) {
+	if m.synth != nil {
+		m.synth.digitalTap = enabled
+		m.synth.digitalBuf = nil
+	}
+}
+
+// DrainDigitalAudio drains samples already generated by FlushAudio/DrainAudio.
+// It does not advance or sample any device. With the tap disabled it returns nil.
+func (m *Machine) DrainDigitalAudio() []int16 {
+	if m.synth == nil {
+		return nil
+	}
+	b := m.synth.digitalBuf
+	m.synth.digitalBuf = nil
+	return b
+}
