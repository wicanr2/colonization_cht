+
+// processLifecycle 是 registry 裡程序可用於 MCB owner 檢查的生命週期。
+// terminated 不接受為 raw MCB owner；TSR 僅在完整一致的 retained chain 中保留。
+type processLifecycle uint8
+
+const (
+	processActive processLifecycle = iota + 1
+	processSuspended
+	processTSR
+	processTerminated
+)
+
+type processRecord struct {
+	psp       uint16
+	parent    uint16
+	lifecycle processLifecycle
+	name      [8]byte
+	blocks    []uint16
+}
+
+// MCBHeaderSnapshot 是一格 raw MCB header 的可診斷副本。
+type MCBHeaderSnapshot struct {
+	Seg uint16
+	Raw [16]byte
+}
+
+// MCBImportFailure 保存被拒絕的鏈前綴。它不會觸碰客體記憶體。
+type MCBImportFailure struct {
+	Reason  string
+	Records []MCBHeaderSnapshot
+}
+
+type mcbHeaderSnapshot = MCBHeaderSnapshot
+
+func blankMCBName() [8]byte {
+	return [8]byte{' ', ' ', ' ', ' ', ' ', ' ', ' ', ' '}
+}
+
+func newMCBBlock(seg, size, owner uint16, name [8]byte) memBlock {
+	b := memBlock{seg: seg, size: size, free: owner == 0, owner: owner, name: name}
+	b.raw[0] = 'M'
+	b.raw[8] = name[0]
+	copy(b.raw[8:16], name[:])
+	b.applyRaw(false)
+	return b
+}
+
+func readMCBBlock(m *machine.Machine, seg uint16) memBlock {
+	var b memBlock
+	b.seg = seg
+	lin := uint32(seg) * 16
+	for i := range b.raw {
+		b.raw[i] = m.Read8(lin + uint32(i))
+	}
+	b.owner = uint16(b.raw[1]) | uint16(b.raw[2])<<8
+	b.size = uint16(b.raw[3]) | uint16(b.raw[4])<<8
+	b.free = b.owner == 0
+	copy(b.name[:], b.raw[8:16])
+	return b
+}
+
+func (b *memBlock) applyRaw(last bool) {
+	if last {
+		b.raw[0] = 'Z'
+	} else {
+		b.raw[0] = 'M'
+	}
+	b.raw[1], b.raw[2] = byte(b.owner), byte(b.owner>>8)
+	b.raw[3], b.raw[4] = byte(b.size), byte(b.size>>8)
+	copy(b.raw[8:16], b.name[:])
+}
+
+func (d *DOS) writeMCBBlock(b *memBlock, last bool) {
+	b.applyRaw(last)
+	d.M.WriteBytes(uint32(b.seg)*16, b.raw[:])
+}
+
+func (d *DOS) captureMCBSnapshot() {
+	d.mcbSnapshot = nil
+	seg := d.M.Read16(uint32(machine.LOLSeg)*16 + 0x0E)
+	for i := 0; i < 512 && seg < uint16(machine.MemTop); i++ {
+		b := readMCBBlock(d.M, seg)
+		d.mcbSnapshot = append(d.mcbSnapshot, mcbHeaderSnapshot{Seg: seg, Raw: b.raw})
+		if b.raw[0] == 'Z' {
+			return
+		}
+		if b.raw[0] != 'M' || b.size == 0 {
+			return
+		}
+		next := int(seg) + 1 + int(b.size)
+		if next <= int(seg) || next >= machine.MemTop {
+			return
+		}
+		seg = uint16(next)
+	}
+}
+
+func (d *DOS) mcbMatchesSnapshot() bool {
+	if len(d.mcbSnapshot) == 0 {
+		return false
+	}
+	for _, s := range d.mcbSnapshot {
+		lin := uint32(s.Seg) * 16
+		for i, want := range s.Raw {
+			if d.M.Read8(lin+uint32(i)) != want {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (d *DOS) noteMCBImportFailure(reason string, records []mcbHeaderSnapshot) {
+	d.MCBImportFailures = append(d.MCBImportFailures, MCBImportFailure{
+		Reason:  reason,
+		Records: append([]mcbHeaderSnapshot(nil), records...),
+	})
+}
+
+func (d *DOS) processCanOwn(psp uint16) bool {
+	p := d.processes[psp]
+	return p != nil && (p.lifecycle == processActive || p.lifecycle == processSuspended || p.lifecycle == processTSR)
+}
+
+func (d *DOS) currentProcess() (*processRecord, bool) {
+	p := d.processes[d.curPSP]
+	return p, p != nil && p.lifecycle == processActive
+}
+
+func (d *DOS) rebuildProcessBlocks() {
+	for _, p := range d.processes {
+		p.blocks = nil
+	}
+	if p := d.processes[d.programBlock.owner]; p != nil && !d.programBlock.free {
+		p.blocks = append(p.blocks, d.programBlock.seg)
+	}
+	for _, b := range d.arena {
+		if b.free {
+			continue
+		}
+		if p := d.processes[b.owner]; p != nil {
+			p.blocks = append(p.blocks, b.seg)
+		}
+	}
+}
+
+// reserveProcessBlock 從 arena 取一格給已登錄程序。它不碰 CPU 暫存器，供
+// EXEC 在 LoadProgramAt 成功後以同一份 typed model 登錄 child MCB。
+func (d *DOS) reserveProcessBlock(want, owner uint16, name [8]byte) (uint16, bool) {
+	d.initArena()
+	i := d.pickBlock(want)
+	if i < 0 {
+		return 0, false
+	}
+	b := &d.arena[i]
+	if b.size >= want+2 {
+		rest := newMCBBlock(b.seg+want+1, b.size-want-1, 0, blankMCBName())
+		b.size = want
+		d.arena = append(d.arena, memBlock{})
+		copy(d.arena[i+2:], d.arena[i+1:])
+		d.arena[i+1] = rest
+		// append 可能搬移底層陣列，不能再用舊 pointer 寫 owner。
+		b = &d.arena[i]
+	}
+	b.free, b.owner, b.name = false, owner, name
+	d.rebuildProcessBlocks()
+	return b.seg + 1, true
+}
+
+func (d *DOS) releaseProcessBlocks(psp uint16) {
+	for i := range d.arena {
+		if !d.arena[i].free && d.arena[i].owner == psp {
+			d.arena[i].free, d.arena[i].owner = true, 0
+		}
+	}
+	d.coalesce()
+	d.rebuildProcessBlocks()
+}
+
+// retainTSR 對已登錄 child 只接受「初始程序 block、無額外配置、與 raw chain
+// 一致」的局部模型。其他 TSR 生命週期仍在 READY 規格的停止線外。
+func (d *DOS) retainTSR(keep uint16) bool {
+	p, ok := d.currentProcess()
+	if !ok || p.psp == machine.PSPSeg || len(p.blocks) != 1 || p.blocks[0]+1 != p.psp {
+		return false
+	}
+	i := -1
+	for n := range d.arena {
+		if d.arena[n].seg == p.blocks[0] && !d.arena[n].free && d.arena[n].owner == p.psp {
+			i = n
+			break
+		}
+	}
+	if i < 0 || keep == 0 {
+		return false
+	}
+	b := &d.arena[i]
+	switch {
+	case keep == b.size:
+	case keep < b.size:
+		if b.size < keep+2 {
+			return false
+		}
+		rest := newMCBBlock(b.seg+keep+1, b.size-keep-1, 0, blankMCBName())
+		b.size = keep
+		d.arena = append(d.arena, memBlock{})
+		copy(d.arena[i+2:], d.arena[i+1:])
+		d.arena[i+1] = rest
+		d.coalesce()
+	case i+1 < len(d.arena) && d.arena[i+1].free && b.size+1+d.arena[i+1].size >= keep:
+		available := b.size + 1 + d.arena[i+1].size
+		d.arena = append(d.arena[:i+1], d.arena[i+2:]...)
+		b = &d.arena[i]
+		b.size = available
+		if b.size >= keep+2 {
+			rest := newMCBBlock(b.seg+keep+1, b.size-keep-1, 0, blankMCBName())
+			b.size = keep
+			d.arena = append(d.arena, memBlock{})
+			copy(d.arena[i+2:], d.arena[i+1:])
+			d.arena[i+1] = rest
+		}
+	default:
+		return false
+	}
+	p.lifecycle = processTSR
+	d.rebuildProcessBlocks()
+	return true
+}
+
+// ensureMCB 只在客體未改動 header 時沿用 typed model；直接改寫時必須完整匯入。
+func (d *DOS) ensureMCB() bool {
+	// 既有測試會在 Install 後設定 freeSeg；那是尚未發布的本地模型變更，
+	// 不是客體 direct write，必須先依新邊界建鏈。
+	if d.arena == nil && d.programBlock.seg+1+d.programBlock.size != d.freeSeg {
+		d.programBlock.size = d.freeSeg - machine.PSPSeg
+		d.programBlock.owner = machine.PSPSeg
+		d.programBlock.free = false
+		d.initArena()
+		d.syncMCB()
+		return true
+	}
+	if d.mcbMatchesSnapshot() {
+		return true
+	}
+	return d.importMCB()
+}
+
+func (d *DOS) prepareMCBCall(c *cpu.CPU) bool {
+	if d.ensureMCB() {
+		return true
+	}
+	c.R[cpu.AX] = 9 // invalid memory block address / unaccepted MCB chain
+	setCarry(c)
+	return false
+}
+
+// importMCB 將客體 list-of-lists 指向的完整 raw chain 轉為 typed model。
+// 失敗時僅留下診斷，不覆寫 raw headers。
+func (d *DOS) importMCB() bool {
+	head := d.M.Read16(uint32(machine.LOLSeg)*16 + 0x0E)
+	var seen = map[uint16]bool{}
+	var records []mcbHeaderSnapshot
+	var blocks []memBlock
+	seg := head
+	for i := 0; i < 512; i++ {
+		if seg >= uint16(machine.MemTop) || seen[seg] {
+			d.noteMCBImportFailure("MCB segment 越界或成環", records)
+			return false
+		}
+		seen[seg] = true
+		b := readMCBBlock(d.M, seg)
+		records = append(records, mcbHeaderSnapshot{Seg: seg, Raw: b.raw})
+		if b.raw[0] != 'M' && b.raw[0] != 'Z' {
+			d.noteMCBImportFailure(fmt.Sprintf("MCB %04X 的 signature 不是 M/Z", seg), records)
+			return false
+		}
+		if b.free {
+			if b.owner != 0 {
+				d.noteMCBImportFailure(fmt.Sprintf("自由 MCB %04X 的 owner 非零", seg), records)
+				return false
+			}
+		} else if !d.processCanOwn(b.owner) {
+			d.noteMCBImportFailure(fmt.Sprintf("MCB %04X 的 owner %04X 未登錄或已終止", seg, b.owner), records)
+			return false
+		}
+		next := int(seg) + 1 + int(b.size)
+		if next <= int(seg) || next > machine.MemTop {
+			d.noteMCBImportFailure(fmt.Sprintf("MCB %04X 的 size %04X 不會嚴格前進", seg, b.size), records)
+			return false
+		}
+		blocks = append(blocks, b)
+		if b.raw[0] == 'Z' {
+			if next != machine.MemTop {
+				d.noteMCBImportFailure(fmt.Sprintf("鏈尾 %04X 未落在 MemTop", seg), records)
+				return false
+			}
+			break
+		}
+		seg = uint16(next)
+	}
+	if len(blocks) == 0 || blocks[len(blocks)-1].raw[0] != 'Z' {
+		d.noteMCBImportFailure("MCB chain 沒有唯一 Z 鏈尾", records)
+		return false
+	}
+	root := blocks[0]
+	if head != machine.PSPSeg-1 || root.free || root.owner != machine.PSPSeg {
+		d.noteMCBImportFailure("MCB chain 首格不是已登錄 root PSP block", records)
+		return false
+	}
+	d.programBlock = root
+	d.freeSeg = root.seg + 1 + root.size
+	d.arena = append([]memBlock(nil), blocks[1:]...)
+	d.rebuildProcessBlocks()
+	d.mcbSnapshot = append([]mcbHeaderSnapshot(nil), records...)
+	return true
+}
+
+// syncMCB 只從已接受的 typed model 發布，並保留 raw header 的 opaque bytes/name。
+func (d *DOS) syncMCB() {
+	// 測試與 supervisor 可能尚未走 machine.Load*；仍要把 list-of-lists
+	// 指向同一條可匯入的 root MCB，不能留在中斷向量的零頁資料。
+	d.M.Write16(uint32(machine.LOLSeg)*16+0x0E, machine.PSPSeg-1)
+	d.programBlock.seg = machine.PSPSeg - 1
+	d.programBlock.size = d.freeSeg - machine.PSPSeg
+	d.programBlock.owner = machine.PSPSeg
+	d.programBlock.free = false
+	if len(d.arena) == 0 {
+		if d.freeSeg >= uint16(machine.MemTop) {
+			d.writeMCBBlock(&d.programBlock, true)
+		} else {
+			d.writeMCBBlock(&d.programBlock, false)
+			free := newMCBBlock(d.freeSeg, uint16(machine.MemTop)-d.freeSeg-1, 0, blankMCBName())
+			d.writeMCBBlock(&free, true)
+		}
+		d.captureMCBSnapshot()
+		return
+	}
+	d.writeMCBBlock(&d.programBlock, false)
+	for i := range d.arena {
+		d.writeMCBBlock(&d.arena[i], i == len(d.arena)-1)
+	}
+	d.rebuildProcessBlocks()
+	d.captureMCBSnapshot()
+}
diff --git a/internal/dos/mcb_import_contract_test.go b/internal/dos/mcb_import_contract_test.go
new file mode 100644
index 0000000..bbac915
--- /dev/null
+++ b/internal/dos/mcb_import_contract_test.go
@@ -0,0 +1,160 @@
+package dos
+
+import (
+	"bytes"
+	"encoding/gob"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+func writeRawMCB(m *machine.Machine, seg uint16, last bool, owner, size uint16, name [8]byte) {
+	m.WriteMCB(seg, last, owner, size)
+	m.WriteBytes(uint32(seg)*16+8, name[:])
+}
+
+func mcbName(s string) [8]byte {
+	n := blankMCBName()
+	copy(n[:], []byte(s))
+	return n
+}
+
+func opaqueMCBName(s string) [8]byte {
+	var n [8]byte
+	copy(n[:], []byte(s))
+	return n
+}
+
+// 這是固定 OPENING.EXE 直接改 MCB 的縮小模型：raw `$sys$` 不是由 AH=48h
+// 建立，下一個 AH=62h 必須匯入且不能被 publisher 洗回空白。
+func TestDirectMCBImportPreservesOpaqueNameAndFailureDoesNotRepublish(t *testing.T) {
+	m, d := newTest(t)
+	d.syncMCB()
+	const first = 0x2000
+	const size = 0x0010
+	next := uint16(first + 1 + size)
+	name := opaqueMCBName("$sys$")
+	writeRawMCB(m, first, false, machine.PSPSeg, size, name)
+	writeRawMCB(m, next, true, 0, uint16(machine.MemTop)-next-1, blankMCBName())
+	if d.mcbMatchesSnapshot() {
+		t.Fatal("direct MCB write 沒有讓 raw snapshot 失配")
+	}
+
+	call(m, d, 0x21, 0x6200)
+	if m.CPU.Flags&cpu.CF != 0 || m.CPU.R[cpu.BX] != machine.PSPSeg {
+		t.Fatalf("AH=62h 匯入後回 CF=%t BX=%04X", m.CPU.Flags&cpu.CF != 0, m.CPU.R[cpu.BX])
+	}
+	if len(d.arena) != 2 || d.arena[0].owner != machine.PSPSeg || d.arena[0].name != name {
+		t.Fatalf("raw MCB 沒有保留為 typed arena：%+v", d.arena)
+	}
+	before := [8]byte{}
+	copy(before[:], m.Mem[uint32(first)*16+8:uint32(first)*16+16])
+	m.CPU.Seg[cpu.ES] = 0x8FFF
+	call(m, d, 0x21, 0x4900)
+	if m.CPU.Flags&cpu.CF == 0 || m.CPU.R[cpu.AX] != 9 {
+		t.Fatalf("未知 AH=49h 回 CF=%t AX=%04X，預期 CF=1 AX=9", m.CPU.Flags&cpu.CF != 0, m.CPU.R[cpu.AX])
+	}
+	after := [8]byte{}
+	copy(after[:], m.Mem[uint32(first)*16+8:uint32(first)*16+16])
+	if after != before || after != name {
+		t.Fatalf("失敗 AH=49h 重發了舊 arena 或遺失 name：%q → %q", before, after)
+	}
+}
+
+func TestMCBImportRejectsUnregisteredOwnerWithoutWritingGuestMemory(t *testing.T) {
+	m, d := newTest(t)
+	d.syncMCB()
+	const first = 0x2000
+	writeRawMCB(m, first, true, 0x3333, uint16(machine.MemTop)-first-1, mcbName("FOREIGN"))
+	if d.mcbMatchesSnapshot() {
+		t.Fatal("foreign owner write 沒有讓 raw snapshot 失配")
+	}
+	before := [16]byte{}
+	copy(before[:], m.Mem[uint32(first)*16:uint32(first)*16+16])
+
+	call(m, d, 0x21, 0x6200)
+	if m.CPU.Flags&cpu.CF == 0 || m.CPU.R[cpu.AX] != 9 {
+		t.Fatalf("未登錄 owner 回 CF=%t AX=%04X，預期 CF=1 AX=9", m.CPU.Flags&cpu.CF != 0, m.CPU.R[cpu.AX])
+	}
+	after := [16]byte{}
+	copy(after[:], m.Mem[uint32(first)*16:uint32(first)*16+16])
+	if after != before || len(d.MCBImportFailures) == 0 {
+		t.Fatal("被拒絕的 MCB chain 沒保留 guest bytes 或診斷 snapshot")
+	}
+}
+
+func TestRegisteredChildUsesCurrentPSPForMCBServices(t *testing.T) {
+	m, d := newTest(t)
+	writeChild(t, d, "WAIT.COM", []byte{0xF4})
+	execChild(m, d, "WAIT.COM")
+	child := d.curPSP
+	call(m, d, 0x21, 0x5100)
+	if m.CPU.Flags&cpu.CF != 0 || m.CPU.R[cpu.BX] != child {
+		t.Fatalf("AH=51h 回 BX=%04X，預期 child %04X", m.CPU.R[cpu.BX], child)
+	}
+	seg := allocPara(m, d, 0x20)
+	if seg == 0 {
+		t.Fatal("child AH=48h 配置失敗")
+	}
+	if owner := m.Read16(uint32(seg-1)*16 + 1); owner != child {
+		t.Fatalf("child AH=48h MCB owner=%04X，預期 %04X", owner, child)
+	}
+	if !freePara(m, d, seg) {
+		t.Fatal("child 自己的 AH=49h 釋放失敗")
+	}
+}
+
+func TestTSRWithExtraChildBlockFailsClosed(t *testing.T) {
+	m, d := newTest(t)
+	writeChild(t, d, "WAIT.COM", []byte{0xF4})
+	execChild(m, d, "WAIT.COM")
+	if allocPara(m, d, 0x20) == 0 {
+		t.Fatal("安排 TSR rejection 的 child 配置失敗")
+	}
+	before := append([]mcbHeaderSnapshot(nil), d.mcbSnapshot...)
+	m.CPU.R[cpu.DX] = 0x40
+	call(m, d, 0x21, 0x3100)
+	if m.CPU.Flags&cpu.CF == 0 || m.CPU.R[cpu.AX] != 9 || d.curPSP == machine.PSPSeg {
+		t.Fatalf("額外 child block 的 TSR 應拒絕：CF=%t AX=%04X cur=%04X", m.CPU.Flags&cpu.CF != 0, m.CPU.R[cpu.AX], d.curPSP)
+	}
+	if len(before) != len(d.mcbSnapshot) {
+		t.Fatal("被拒絕的 TSR 改寫了 MCB snapshot")
+	}
+}
+
+func TestStateV3PreservesMCBAndRejectsV2(t *testing.T) {
+	m, d := newTest(t)
+	d.syncMCB()
+	const first = 0x2000
+	const size = 0x0010
+	next := uint16(first + 1 + size)
+	name := opaqueMCBName("$pack$")
+	writeRawMCB(m, first, false, machine.PSPSeg, size, name)
+	writeRawMCB(m, next, true, 0, uint16(machine.MemTop)-next-1, blankMCBName())
+	call(m, d, 0x21, 0x6200)
+	if m.CPU.Flags&cpu.CF != 0 {
+		t.Fatal("state fixture 匯入失敗")
+	}
+
+	var saved bytes.Buffer
+	if err := d.SaveState(&saved); err != nil {
+		t.Fatal(err)
+	}
+	restored := New(m, t.TempDir())
+	restored.Install()
+	if err := restored.LoadState(bytes.NewReader(saved.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	if len(restored.arena) != 2 || restored.arena[0].name != name || restored.arena[0].raw != d.arena[0].raw {
+		t.Fatalf("v3 沒保存 raw name/header：%+v", restored.arena)
+	}
+
+	var v2 bytes.Buffer
+	if err := gob.NewEncoder(&v2).Encode(&dosState{Magic: dosStateMagic, Version: 2}); err != nil {
+		t.Fatal(err)
+	}
+	if err := restored.LoadState(bytes.NewReader(v2.Bytes())); err == nil {
+		t.Fatal("v2 state 竟被接受；不得補猜 owner/name")
+	}
+}
