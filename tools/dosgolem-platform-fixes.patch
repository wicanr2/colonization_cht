@@ -0,0 +1,55 @@
+package dos
+
+import (
+	"bytes"
+	"encoding/gob"
+	"reflect"
+	"testing"
+)
+
+func TestMouseStateAllBehaviorAndNoDiagnostics(t *testing.T) {
+	d := newAt(t, t.TempDir())
+	want := Mouse{X: 19, Y: 27, Buttons: 3, XScale: 2,
+		Press: [3]uint16{1, 2, 3}, Release: [3]uint16{4, 5, 6},
+		PressAt:   [3][2]uint16{{11, 12}, {13, 14}, {15, 16}},
+		ReleaseAt: [3][2]uint16{{21, 22}, {23, 24}, {25, 26}},
+		MickeyX:   -17, MickeyY: 31, MinX: 2, MaxX: 639, MinY: 4, MaxY: 199}
+	want.Handler.Seg, want.Handler.Off, want.Handler.Mask, want.Handler.Set = 0x1234, 0x5678, 1, true
+	d.Mouse = want
+	d.Mouse.Calls = map[uint16]int{3: 17}
+	d.Mouse.Polls, d.Mouse.Sets, d.Mouse.Events = []Poll{{X: 1}}, []Poll{{X: 2}}, []Poll{{X: 3}}
+	d.Mouse.PressQ, d.Mouse.PressReads = [3]uint64{3, 4, 5}, []PressRead{{Count: 7}}
+	var buf bytes.Buffer
+	if err := d.SaveState(&buf); err != nil {
+		t.Fatal(err)
+	}
+	var disk dosState
+	if err := gob.NewDecoder(bytes.NewReader(buf.Bytes())).Decode(&disk); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(disk.Mouse, want) {
+		t.Fatalf("磁碟滑鼠狀態不符：%+v", disk.Mouse)
+	}
+	e := newAt(t, t.TempDir())
+	e.Mouse = d.Mouse // 載入必須清除目的端的舊診斷。
+	if err := e.LoadState(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(e.Mouse, want) {
+		t.Fatalf("還原滑鼠狀態不符：%+v", e.Mouse)
+	}
+	if !e.MouseEvent(1) {
+		t.Fatal("還原後沒有投遞移動事件")
+	}
+	if e.M.CallbackPending() != 1 {
+		t.Fatal("還原的回呼未排入佇列")
+	}
+	disk.Version = 3
+	buf.Reset()
+	if err := gob.NewEncoder(&buf).Encode(&disk); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.LoadState(&buf); err == nil {
+		t.Fatal("不得接受缺少滑鼠狀態的 v3")
+	}
+}
