@@ -0,0 +1,98 @@
+package machine
+
+import "testing"
+
+func sbproOPLOut(m *Machine, port uint16, reg, val uint8) {
+	m.Out8(port, reg)
+	m.Out8(port+1, val)
+}
+
+// TestSBProProfileDisabledByDefault 確認一般 Machine 的既有回退完全不變。
+func TestSBProProfileDisabledByDefault(t *testing.T) {
+	m := New()
+	for _, port := range []uint16{0x220, 0x222, 0x22a, 0x22c, 0x22e} {
+		if got := m.In8(port); got != 0xff {
+			t.Fatalf("profile 關閉時 port %03X=%02X，要維持 FF 回退", port, got)
+		}
+	}
+	m.Out8(0x220, 0x20)
+	m.Out8(0x221, 0x31)
+	if got := m.OPLRegs(0)[0x20]; got != 0 {
+		t.Fatalf("profile 關閉卻寫入 primary OPL：%02X", got)
+	}
+	if m.sbproEnabled || m.sbproDSP.reset || len(m.sbproDSP.reply) != 0 {
+		t.Fatal("profile 關閉卻改變 DSP 狀態")
+	}
+}
+
+// TestSBProProfileOPLPorts 僅驗證 READY 的 base 0x220 映射，不宣稱 OPL3 parity。
+func TestSBProProfileOPLPorts(t *testing.T) {
+	m := New()
+	m.SetSoundBlasterPro(true)
+
+	sbproOPLOut(m, 0x220, 0x04, 0x60)
+	sbproOPLOut(m, 0x220, 0x04, 0x80)
+	if got := m.In8(0x220); got != 0x00 {
+		t.Fatalf("第一次 primary status=%02X，要 00", got)
+	}
+	sbproOPLOut(m, 0x220, 0x02, 0xff)
+	sbproOPLOut(m, 0x220, 0x04, 0x21)
+	if got := m.In8(0x220); got != 0xc0 {
+		t.Fatalf("timer 啟動後 primary status=%02X，要 C0", got)
+	}
+
+	sbproOPLOut(m, 0x220, 0x20, 0x11)
+	sbproOPLOut(m, 0x222, 0x20, 0x22)
+	if got := m.OPLRegs(0)[0x20]; got != 0x11 {
+		t.Fatalf("primary bank=%02X，要 11", got)
+	}
+	if got := m.OPLRegs(1)[0x20]; got != 0x22 {
+		t.Fatalf("secondary bank=%02X，要 22", got)
+	}
+
+	beforeTicks := m.portTicks
+	beforeReads := m.PortsIn[0x222]
+	if got := m.In8(0x222); got != 0xff {
+		t.Fatalf("advanced delay read=%02X，要受限回退 FF", got)
+	}
+	if m.portTicks != beforeTicks+1 || m.PortsIn[0x222] != beforeReads+1 {
+		t.Fatalf("0x222 讀取沒有恰好一次記錄：ticks=%d reads=%d", m.portTicks-beforeTicks, m.PortsIn[0x222]-beforeReads)
+	}
+}
+
+func TestSBProProfileDSPResetAndPhysicalPortLog(t *testing.T) {
+	m := New()
+	m.SetSoundBlasterPro(true)
+
+	beforeTicks := m.portTicks
+	m.Out8(0x226, 1)
+	if got := m.In8(0x22c); got != 0x80 {
+		t.Fatalf("reset 中 0x22C=%02X，要 80", got)
+	}
+	m.Out8(0x226, 0)
+	if got := m.In8(0x22e); got != 0x80 {
+		t.Fatalf("reset reply status=%02X，要 80", got)
+	}
+	if got := m.In8(0x22a); got != 0xaa {
+		t.Fatalf("reset reply=%02X，要 AA", got)
+	}
+	if got := m.In8(0x22e); got != 0 {
+		t.Fatalf("消費 reply 後 status=%02X，要 00", got)
+	}
+	if got := m.In8(0x22c); got != 0 {
+		t.Fatalf("reset 完成後 0x22C=%02X，要 00", got)
+	}
+	if m.portTicks != beforeTicks+5 {
+		t.Fatalf("五次實體讀取 tick=%d，要 5", m.portTicks-beforeTicks)
+	}
+	if len(m.PortLog) != 2 || m.PortLog[0].Port != 0x226 || m.PortLog[1].Port != 0x226 {
+		t.Fatalf("reset 寫入不是實體 port 的單筆記錄：%+v", m.PortLog)
+	}
+
+	m.PortLog = nil
+	m.Out8(0x220, 0x20)
+	m.Out8(0x221, 0x31)
+	if len(m.PortLog) != 2 || m.PortLog[0].Port != 0x220 || m.PortLog[1].Port != 0x221 {
+		t.Fatalf("OPL alias 沒有保留每筆實體 port：%+v", m.PortLog)
+	}
+}
