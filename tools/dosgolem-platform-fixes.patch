@@ -0,0 +1,10 @@
+package dos
+
+// mouseBehaviorState 保留全部行為欄位，移除本趟診斷紀錄。
+// 契約：docs/spec/196-mouse-snapshot.md。
+func mouseBehaviorState(m Mouse) Mouse {
+	m.Polls, m.Sets, m.PressReads, m.Events = nil, nil, nil, nil
+	m.Calls = nil
+	m.PressQ = [3]uint64{}
+	return m
+}
