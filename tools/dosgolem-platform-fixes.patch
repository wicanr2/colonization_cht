@@ -0,0 +1,69 @@
+package machine
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/cpu"
+)
+
+// 平台契約見 docs/spec/194-bios-disk-motor-timeout.md。
+// 以真正執行 stub 的結果驗證倒數、中斷鏈及保存契約。
+func TestBIOSDiskMotorTimeout(t *testing.T) {
+	for _, initial := range []uint8{0, 1, 2, 255} {
+		for _, chain := range []bool{true, false} {
+			t.Run(fmt.Sprintf("count=%d/chain=%v", initial, chain), func(t *testing.T) {
+				m := New()
+				const scratch = 0x2000
+				m.Write8(0x440, initial)
+				m.Write8(0x43F, 0xAF)
+				m.Write8(0x490, 0xCC)
+				// int 1Ch 在 DS=40h 下觀測倒數，再弄髒 BIOS 應保存的暫存器。
+				m.WriteBytes(cpu.Addr(scratch, 0x300), []byte{
+					0xA0, 0x40, 0x00, 0xA2, 0x90, 0x00,
+					0xB8, 0xEF, 0xBE, 0x8E, 0xD8,
+					0xBA, 0x34, 0x12, 0xCF,
+				})
+				m.Write16(0x1C*4, 0x300)
+				m.Write16(0x1C*4+2, scratch)
+				if !chain {
+					m.WriteBytes(cpu.Addr(scratch, 0x380), []byte{0xCF})
+					m.Write16(0x08*4, 0x380)
+					m.Write16(0x08*4+2, scratch)
+				}
+				m.WriteBytes(cpu.Addr(scratch, 0x400), []byte{0xF4})
+				m.CPU.Seg[cpu.CS], m.CPU.IP = scratch, 0x400
+				m.CPU.Seg[cpu.DS], m.CPU.Seg[cpu.SS] = 0x5678, scratch
+				m.CPU.R[cpu.SP], m.CPU.R[cpu.AX], m.CPU.R[cpu.DX] = 0x200, 0x1357, 0x2468
+				m.CPU.SetFlags(cpu.IF | cpu.CF | cpu.ZF)
+				beforeR, beforeSeg, beforeFlags := m.CPU.R, m.CPU.Seg, m.CPU.Flags
+				m.CPU.Interrupt(0x08)
+				for i := 0; i < 100 && !m.CPU.Halted; i++ {
+					if err := m.Step(); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if !m.CPU.Halted {
+					t.Fatal("BIOS 中斷未返回")
+				}
+				wantCount, wantStatus, wantSeen := initial, uint8(0xAF), uint8(0xCC)
+				if chain {
+					if wantCount > 0 {
+						wantCount--
+					}
+					if initial == 1 {
+						wantStatus = 0xA0
+					}
+					wantSeen = wantCount
+				}
+				if m.Read8(0x440) != wantCount || m.Read8(0x43F) != wantStatus || m.Read8(0x490) != wantSeen {
+					t.Fatalf("倒數／狀態／1Ch觀測 = %02X/%02X/%02X，預期 %02X/%02X/%02X",
+						m.Read8(0x440), m.Read8(0x43F), m.Read8(0x490), wantCount, wantStatus, wantSeen)
+				}
+				if m.CPU.R != beforeR || m.CPU.Seg != beforeSeg || m.CPU.Flags != beforeFlags {
+					t.Fatal("BIOS 中斷未保存暫存器或旗標")
+				}
+			})
+		}
+	}
+}
