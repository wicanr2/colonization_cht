@@ -0,0 +1,25 @@
+package state
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/wicanr2/dosgolem/internal/machine"
+)
+
+func TestUnsafeCallbackDoesNotTruncateState(t *testing.T) {
+	m, d := boot(t)
+	path := filepath.Join(t.TempDir(), "existing.state")
+	if err := os.WriteFile(path, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	m.QueueCallback(machine.QueuedCall{Seg: 0x100})
+	if err := Save(path, m, d); err == nil {
+		t.Fatal("待執行回呼應拒絕保存")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil || string(data) != "keep" {
+		t.Fatal("失敗不應破壞既有檔案")
+	}
+}
