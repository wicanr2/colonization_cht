+func TestMouseExchangeHandler(t *testing.T) {
+	m, d := newTest(t)
+	install := func(fn, seg, off, mask uint16) {
+		m.CPU.Seg[cpu.ES], m.CPU.R[cpu.DX], m.CPU.R[cpu.CX] = seg, off, mask
+		call(m, d, 0x33, fn)
+	}
+	checkOld := func(seg, off, mask uint16) {
+		t.Helper()
+		if m.CPU.Seg[cpu.ES] != seg || m.CPU.R[cpu.DX] != off || m.CPU.R[cpu.CX] != mask {
+			t.Fatalf("舊回呼 = %04X:%04X/%04X，預期 %04X:%04X/%04X",
+				m.CPU.Seg[cpu.ES], m.CPU.R[cpu.DX], m.CPU.R[cpu.CX], seg, off, mask)
+		}
+	}
+	// 未註冊→A，然後以 000C 設 B，再交換回 A。
+	install(0x14, 0x3000, 0x100, EventMove)
+	checkOld(0, 0, 0)
+	install(0x0C, 0x3100, 0x200, EventLeftDown)
+	install(0x14, 0x3000, 0x100, EventMove)
+	checkOld(0x3100, 0x200, EventLeftDown)
+	if !d.MouseEvent(EventMove) || d.MouseEvent(EventLeftDown) || m.CallbackPending() != 1 {
+		t.Fatal("交换後事件未依新遮罩排隊")
+	}
+	// 零遮罩停用，且交換時仍完整返回 A。
+	install(0x14, 0, 0, 0)
+	checkOld(0x3000, 0x100, EventMove)
+	if d.MouseEvent(EventMove) || m.CallbackPending() != 1 {
+		t.Fatal("零遮罩仍投遞新事件")
+	}
+	install(0x0C, 0x3100, 0x200, EventMove)
+	call(m, d, 0x33, 0)
+	install(0x14, 0x3000, 0x100, EventMove)
+	checkOld(0, 0, 0)
+	if len(d.Unimplemented) != 0 {
+		t.Fatal("交換標準服務仍被記為未實作")
+	}
+}
