+package machine
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestFileStateRejectsUnsafeCallbackAndClearsDestination(t *testing.T) {
+	m := New()
+	var safe bytes.Buffer
+	if err := m.SaveState(&safe); err != nil {
+		t.Fatal(err)
+	}
+	m.QueueCallback(QueuedCall{Seg: 0x100, Off: 0})
+	var rejected bytes.Buffer
+	if err := m.SaveState(&rejected); err == nil || rejected.Len() != 0 {
+		t.Fatal("待執行回呼應拒絕保存")
+	}
+	m.startCallback()
+	if err := m.SaveState(&rejected); err == nil || rejected.Len() != 0 {
+		t.Fatal("執行中回呼應拒絕保存")
+	}
+	if err := m.LoadState(&safe); err != nil {
+		t.Fatal(err)
+	}
+	if m.CallbackActive() || m.CallbackPending() != 0 || m.CallbacksMade() != 0 {
+		t.Fatal("載入後殘留舊回呼")
+	}
+}
